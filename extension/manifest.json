{
  "manifest_version": 3,
  "name": "Omarchy FF Sync",
  "version": "1.8.2",
  "description": "Keeps Firefox and Zen Browser in sync with the current Omarchy theme.",
  "browser_specific_settings": {
    "gecko": {
      "id": "omarchy-ff-sync@bb.hab.rip",
      "strict_min_version": "156.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "theme",
    "topSites"
  ],
  "background": {
    "scripts": [
      "theme.js",
      "wallpaper.js",
      "tabglow.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Omarchy FF Sync",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/omafox.svg",
      "32": "icons/omafox.svg",
      "48": "icons/omafox.svg",
      "96": "icons/omafox.svg"
    }
  },
  "icons": {
    "48": "icons/omafox.svg",
    "96": "icons/omafox.svg"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ]
}
